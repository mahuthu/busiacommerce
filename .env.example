# Supabase (Project Settings → API)
# Prefer the anon/public JWT key (starts with eyJ...) if the publishable key fails with supabase-js.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Only needed for scripts/seed_supabase.mjs (service_role / secret key)
# Do NOT put this in Vite client code or commit it.
# Not the postgres:// database URL — use the API service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
